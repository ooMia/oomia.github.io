---
import RootLayout from "#layouts/RootLayout.astro";

import type { CodeLanguage } from "astro";
import { Code as Shiki } from "astro:components";

const Code = {
  Component: Shiki,
  props: {
    lang: "ts" as CodeLanguage,
    code: `interface ImportMetaEnv {
  readonly GOOGLE_TAG_MANAGER_ID: string;
}

interface ImportMeta {
  readonly env: ImportMetaEnv;
}` as string,
  },
};
---

<RootLayout title="" description="">
  <h1>head1 헤드1</h1>
  <h2>head2 헤드2</h2>
  <h3>head3 헤드3</h3>
  <h4>head4 헤드4</h4>

  <aside
    class="block-color-gray_background callout"
    data-notion-callout=""
    data-notion-callout-icon="💡"
    data-notion-callout-background="gray_background"
    style="white-space:pre-wrap;display:flex"
    dir="ltr"
  >
    <div style="font-size:1.5em">
      <span class="icon" data-emoji="💡"></span>
    </div><div style="width:100%">
      <p>callout</p>
    </div>
  </aside>
  <Code.Component {...Code.props} />
</RootLayout>
