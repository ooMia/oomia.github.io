---
import { $ } from "#lib/globals";

const desc = $.desc.toValue();
const blogger = $.blogger.toValue();

const image = $.image.toValue();
const blogImageDesc = $.blog.image.$doc;
---

<section>
  <div>
    <img src={image} alt={blogImageDesc} />
    <div>{desc}<span>{blogger}</span></div>
  </div>
</section>
