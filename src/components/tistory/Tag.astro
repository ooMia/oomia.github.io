---
type Condition = "always" | "if" | "ifNot";

export interface Props {
  tId: string;
  tCondition?: Condition;
  tOption?: boolean;
}

const {
  tId,
  tCondition = "always",
  tOption = false,
  ...restProps
} = Astro.props;

const PREFIX_RULE = {
  always: "",
  if: "if_",
  ifNot: "if_not_",
} as const satisfies Record<Condition, string>;

const prefix = PREFIX_RULE[tCondition];
const id = tOption ? `var_${tId}` : tId;
const TagName = `s_${prefix}${id}`;
---

<TagName {...restProps}>
  <slot />
</TagName>
