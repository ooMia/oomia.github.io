---
// https://tistory.github.io/document-tistory-skin/common/cover.html
---

<div class='list_content'>
  <s_cover_item_thumbnail>
    <a href='[##_cover_item_url_##]' class='thumbnail_post'
      ><img
        src='//i1.daumcdn.net/thumb/C148x148/?fname=[##_cover_item_thumbnail_##]'
      /></a
    >
  </s_cover_item_thumbnail>
  <a href='[##_cover_item_url_##]' class='link_post'>
    <strong class='tit_post'>[##_cover_item_title_##]</strong>
    <p class='txt_post'>[##_cover_item_summary_##]</p>
  </a>
  <div class='detail_info'>
    <a href='[##_cover_item_category_url_##]' class='link_cate'
      >[##_cover_item_category_##]</a
    >
    <span class='txt_bar'></span>
    [##_cover_item_date_##]
  </div>
</div>
