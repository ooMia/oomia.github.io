---
import { $ } from "#lib/tistory/globals";

export const blogMenu = $.blog.menu.toValue();

const rssUrl = $.rss_url.toValue();
const taglogLink = $.taglog_link.toValue();
const guestbookLink = $.guestbook_link.toValue();
---

<ul>
  <li>
    <a href={rssUrl}>RSS구독</a>
  </li>
  <li>
    <a href={taglogLink}>태그</a>
  </li>
  <li>
    <a href={guestbookLink}>방명록</a>
  </li>
</ul>
