{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "module": "preserve",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun", "react"],
    // Some stricter flags
    "strictNullChecks": true,
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "#*": ["./src/*"],
      "#lib/*": ["./lib/*"],
      "#data/*": ["./data/*"],
      "#plugins/*": ["./plugins/*"]
    }
  }
}
