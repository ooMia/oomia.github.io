{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "playwright-report",
    "test-results",
    "data/articles/**",
    "tests/link-card/astro/**"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "strictNullChecks": true,
    "noPropertyAccessFromIndexSignature": true
  }
}
