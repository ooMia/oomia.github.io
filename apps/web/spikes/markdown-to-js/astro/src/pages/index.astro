---
import { getCollection, render } from "astro:content";
import { createLinkCardResolver } from "../../../../../src/lib/content/link-card";
import Callout from "../../../../../src/components/Callout.astro";
import { componentBinding } from "../../../binding";
import records from "../../../fixtures/manifest.json";
const components = { ...componentBinding(createLinkCardResolver(records)).components, Callout };
const entries = [...await getCollection("fixtures"), ...await getCollection("corpus")];
const rendered = await Promise.all(entries.map(async entry => ({ entry, ...await render(entry) })));
---
<html lang="en"><head><meta charset="utf-8" /><title>Markdown component spike</title></head><body>
{rendered.map(({ entry, Content, headings }) => <section data-entry={entry.id} data-collection={entry.collection} data-heading-count={headings.length}><h1>{entry.id}</h1><Content components={components} /></section>)}
</body></html>
