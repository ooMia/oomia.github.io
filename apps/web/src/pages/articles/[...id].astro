---
import ArticleSocialHead from "@/components/ArticleSocialHead.astro";
import { articleSocial } from "@/lib/content/article-social";
import {
  readArticlePreviews,
  previewForArticle,
} from "@/lib/content/article-previews";
import Callout from "@/components/Callout.astro";
import LinkCard from "@/components/LinkCard.astro";
import { ArticleFrame } from "@/components/presentation/ArticleFrame";
import RootLayout from "@/layouts/RootLayout.astro";
import { getArticleRecords } from "@/lib/content/articles";
import render from "@/lib/content/render";
import "@/styles/link-card.css";
import type { InferGetStaticPropsType } from "astro";

export async function getStaticPaths() {
  const articles = await getArticleRecords();
  const previews = readArticlePreviews();

  return articles.map(({ entry, metadata }) => ({
    params: { id: entry.id },
    props: {
      post: entry,
      metadata,
      previewHash: previewForArticle(entry.filePath, previews)?.sha256,
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, metadata, previewHash } = Astro.props as Props;
const article = await render(post);
const social = articleSocial(
  metadata,
  Astro.site!.href,
  import.meta.env.BASE_URL,
  import.meta.env["DOCS_REVISION"],
  previewHash,
);
const toc = article.headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
---

<RootLayout title={metadata.title} description={metadata.description}>
  <ArticleSocialHead slot="head" {social} />
  <ArticleFrame
    pathname={Astro.url.pathname}
    homeUrl={import.meta.env.BASE_URL}
    title={metadata.title}
    description={metadata.description}
    author={metadata.author}
    publishedAt={metadata.publishedAt?.toISOString()}
    updatedAt={metadata.updatedAt?.toISOString()}
    tags={[...metadata.tags]}
    readingMinutes={Math.ceil(
      article.remarkPluginFrontmatter.readingTime.minutes,
    )}
    {toc}
    client:load
  >
    <article.Content components={{ Callout, LinkCard }} />
  </ArticleFrame>
</RootLayout>
