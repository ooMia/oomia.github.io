---
import ArticleSocialHead from "@/components/ArticleSocialHead.astro";
import { articleSocial } from "@/lib/content/article-social";
import {
  readArticlePreviews,
  previewForArticle,
} from "@/lib/content/article-previews";
import Callout from "@/components/Callout.astro";
import LinkCard from "@/components/LinkCard.astro";
import { ArticleFrame } from "@/components/presentation/ArticleFrame";
import RootLayout from "@/layouts/RootLayout.astro";
import { getCollection } from "astro:content";
import { articleSourcePath } from "@/lib/content/article-source";
import { getArticleRecords } from "@/lib/content/articles";
import {
  articleVisual,
  buildTagIndex,
  sortedTags,
} from "@/lib/presentation/articles";
import { localizedArticleUrl } from "@/lib/presentation/locale";
import render from "@/lib/content/render";
import { Font } from "astro:assets";
import "@/styles/link-card.css";
import type { InferGetStaticPropsType } from "astro";

export async function getStaticPaths() {
  const articles = await getArticleRecords();
  const previews = readArticlePreviews();
  const translations = await getCollection("articleTranslations");

  return articles.map(({ entry, metadata }) => ({
    params: { id: entry.id },
    props: {
      post: entry,
      translated: translations.some(
        (x) => x.data.sourcePath === articleSourcePath(entry.filePath),
      ),
      metadata,
      tagIndex: buildTagIndex(articles.map(({ metadata }) => metadata)),
      previewHash: previewForArticle(entry.filePath, previews)?.sha256,
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, metadata, previewHash, tagIndex, translated } =
  Astro.props as Props;
const article = await render(post);
const social = articleSocial(
  metadata,
  Astro.site!.href,
  import.meta.env.BASE_URL,
  import.meta.env["DOCS_REVISION"],
  previewHash,
);
const toc = article.headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
---

<RootLayout title={metadata.title} description={metadata.description}>
  <Font slot="head" cssVariable="--font-gowun" />
  <Font slot="head" cssVariable="--font-literata" />
  <ArticleSocialHead slot="head" {social} />
  {
    translated && (
      <>
        <>
          <link slot="head" rel="alternate" hreflang="ko" href={social.url} />
          <link
            slot="head"
            rel="alternate"
            hreflang="en"
            href={
              new URL(
                localizedArticleUrl(post.id, "en", import.meta.env.BASE_URL),
                Astro.site,
              ).href
            }
          />
        </>
      </>
    )
  }
  <ArticleFrame
    pathname={Astro.url.pathname}
    homeUrl={import.meta.env.BASE_URL}
    title={metadata.title}
    description={metadata.description}
    author={metadata.author}
    publishedAt={metadata.publishedAt?.toISOString()}
    updatedAt={metadata.updatedAt?.toISOString()}
    articleId={post.id}
    visual={articleVisual(metadata)}
    localeUrl={localizedArticleUrl(post.id, "en", import.meta.env.BASE_URL)}
    tags={sortedTags(metadata.tags, tagIndex)}
    readingMinutes={Math.ceil(
      article.remarkPluginFrontmatter.readingTime.minutes,
    )}
    {toc}
    client:load
  >
    <article.Content components={{ Callout, LinkCard }} />
  </ArticleFrame>
</RootLayout>
