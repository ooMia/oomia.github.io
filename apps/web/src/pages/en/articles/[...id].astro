---
import type { InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import ArticleSocialHead from "@/components/ArticleSocialHead.astro";
import Callout from "@/components/Callout.astro";
import LinkCard from "@/components/LinkCard.astro";
import { ArticleFrame } from "@/components/presentation/ArticleFrame";
import RootLayout from "@/layouts/RootLayout.astro";
import { articleSocial } from "@/lib/content/article-social";
import {
  readArticlePreviews,
  previewForArticle,
} from "@/lib/content/article-previews";
import { articleSourcePath } from "@/lib/content/article-source";
import { getArticleRecords } from "@/lib/content/articles";
import render from "@/lib/content/render";
import {
  articleVisual,
  buildTagIndex,
  sortedTags,
} from "@/lib/presentation/articles";
import {
  localizedArticleUrl,
  localizedHomeUrl,
} from "@/lib/presentation/locale";
import "@/styles/link-card.css";
export async function getStaticPaths() {
  const records = await getArticleRecords();
  const previews = readArticlePreviews();
  const localized = await getCollection("articleTranslations");
  const tagIndex = buildTagIndex(records.map(({ metadata }) => metadata));
  return records.map(({ entry, metadata }) => {
    const translated = localized.find(
      (x) => x.data.sourcePath === articleSourcePath(entry.filePath),
    );
    const descriptor = translated?.data;
    return {
      params: { id: entry.id },
      props: {
        post: entry,
        metadata,
        translated,
        descriptor,
        tagIndex,
        previewHash: previewForArticle(entry.filePath, previews)?.sha256,
      },
    };
  });
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, metadata, translated, descriptor, tagIndex, previewHash } =
  Astro.props as Props;
const originalUrl = localizedArticleUrl(
  post.id,
  "ko",
  import.meta.env.BASE_URL,
);
const selected = translated ?? post;
const article = await render(selected);
const display = {
  ...metadata,
  title: translated?.data.title ?? metadata.title,
  description: translated?.data.description ?? metadata.description,
};
const originalSocial = articleSocial(
  display,
  Astro.site!.href,
  import.meta.env.BASE_URL,
  import.meta.env["DOCS_REVISION"],
  previewHash,
);
const translatedUrl = new URL(
  localizedArticleUrl(post.id, "en", import.meta.env.BASE_URL),
  Astro.site,
).href;
const social = translated
  ? {
      ...originalSocial,
      url: translatedUrl,
      jsonLd: JSON.stringify({
        ...JSON.parse(originalSocial.jsonLd),
        url: translatedUrl,
        mainEntityOfPage: translatedUrl,
        inLanguage: "en",
      }).replace(/</g, "\\u003c"),
    }
  : originalSocial;
const toc = article.headings.map((h) => ({
  depth: h.depth,
  title: h.text,
  url: "#" + h.slug,
}));
---

<RootLayout title={display.title} description={display.description} locale="en">
  <ArticleSocialHead slot="head" {social} locale={translated ? "en" : "ko"} />
  {!translated && <meta slot="head" name="robots" content="noindex,follow" />}
  {
    translated && (
      <>
        <>
          <link
            slot="head"
            rel="alternate"
            hreflang="ko"
            href={new URL(originalUrl, Astro.site).href}
          />
          <link
            slot="head"
            rel="alternate"
            hreflang="en"
            href={translatedUrl}
          />
          <meta
            slot="head"
            name="oomia:translation-source-revision"
            content={descriptor?.originalDocsRevision}
          />
          <meta
            slot="head"
            name="oomia:translation-source-sha256"
            content={descriptor?.sourceSha256}
          />
        </>
      </>
    )
  }
  <ArticleFrame
    pathname={Astro.url.pathname}
    homeUrl={localizedHomeUrl("en", import.meta.env.BASE_URL)}
    locale="en"
    localeUrl={originalUrl}
    {originalUrl}
    translated={!!translated}
    fallback={!translated}
    articleId={post.id}
    visual={articleVisual(metadata)}
    title={display.title}
    description={display.description}
    author={metadata.author}
    publishedAt={metadata.publishedAt?.toISOString()}
    updatedAt={metadata.updatedAt?.toISOString()}
    tags={sortedTags(metadata.tags, tagIndex)}
    readingMinutes={Math.ceil(
      article.remarkPluginFrontmatter.readingTime.minutes,
    )}
    {toc}
    client:load
  >
    <article.Content components={{ Callout, LinkCard }} />
  </ArticleFrame></RootLayout
>
