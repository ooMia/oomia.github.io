---
interface Props {
  tone?: "info" | "warning";
}
const { tone = "info" } = Astro.props;
if (!["info", "warning"].includes(tone))
  throw new Error("Unsupported Callout tone");
---

<aside class="callout" data-tone={tone}><slot /></aside>

<style>
  .callout {
    margin-block: 1rem;
    padding: 1rem;
    border-inline-start: 0.25rem solid #2563eb;
    background: #eff6ff;
    color: #172554;
    border-radius: 0.25rem;
  }
  .callout[data-tone="warning"] {
    border-color: #b45309;
    background: #fffbeb;
    color: #451a03;
  }
  :global(.dark) .callout {
    border-color: #60a5fa;
    background: #172554;
    color: #dbeafe;
  }
  :global(.dark) .callout[data-tone="warning"] {
    border-color: #fbbf24;
    background: #451a03;
    color: #fef3c7;
  }
</style>
