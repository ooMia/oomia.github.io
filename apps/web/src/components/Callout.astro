---
interface Props {
  tone?: "info" | "warning";
}
const { tone = "info" } = Astro.props;
if (!["info", "warning"].includes(tone)) throw new Error("Unsupported Callout tone");
---

<aside class="callout" data-tone={tone}><slot /></aside>

<style>
  .callout {
    margin-block: 1rem;
    padding: 1rem;
    border-inline-start: 0.25rem solid #2563eb;
    background: #eff6ff;
    color: #172554;
    border-radius: 0.25rem;
  }
  .callout[data-tone="warning"] {
    border-color: #b45309;
    background: #fffbeb;
    color: #451a03;
  }
</style>
