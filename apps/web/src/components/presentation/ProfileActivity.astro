---
// Browser-loaded visual supplements; captions own semantics and provider colors
// remain theme-independent. Dimensions come from the recorded provider render.
const profiles = [
  {
    label: "90일 GitHub 활동",
    src: "https://ghstats.dev/api/sparkline?username=oomia&days=90&width=700",
    href: "https://github.com/ooMia",
    width: 700,
    height: 80,
  },
  {
    label: "GitHub streak",
    src: "https://streak-stats.demolab.com?user=oomia&theme=dark&card_width=700",
    href: "https://github.com/ooMia",
    width: 700,
    height: 195,
  },
  {
    label: "solved.ac",
    src: "https://github-readme-solvedac.hyp3rflow.vercel.app/api/?handle=hs1891179",
    href: "https://solved.ac/profile/hs1891179",
    width: 700,
    height: 150,
  },
];
---

<section
  aria-labelledby="profile-activity"
  class="mt-10 border-t border-fd-border pt-8"
>
  <h2
    id="profile-activity"
    class="text-base font-medium text-fd-muted-foreground"
  >
    Profile / Activity
  </h2>
  <div class="mt-5 grid min-w-0 gap-5 sm:grid-cols-2">
    {
      profiles.map(({ label, src, href, width, height }, index) => (
        <figure class:list={["min-w-0", { "sm:col-span-2": index === 0 }]}>
          <figcaption class="mb-2 text-xs text-fd-muted-foreground">
            <a href={href} class="hover:underline underline-offset-4">
              {label}
            </a>
          </figcaption>
          <div
            class="relative max-w-full rounded-md"
            style={{ width: `${width}px`, aspectRatio: `${width} / ${height}` }}
          >
            <img
              src={src}
              alt=""
              width={width}
              height={height}
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              class="h-full w-full max-w-full rounded-md object-contain"
            />
            <p
              hidden
              class="absolute inset-0 m-0 content-center rounded-md bg-fd-muted px-3 text-center text-xs text-fd-muted-foreground"
            >
              활동 이미지를 불러올 수 없습니다. 위 프로필 링크를 확인해 주세요.
            </p>
          </div>
        </figure>
      ))
    }
  </div>
</section>
