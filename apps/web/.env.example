# Copy to apps/web/.env for local settings. External environment values win.
SITE_URL=http://localhost:4321
BASE_PATH=/
FILTER_DRAFT_ARTICLES=false

# Direct Astro build/sync defaults to the stored Site gitlink.
DOCS_CHECKOUT_MODE=pinned
# Set only with DOCS_CHECKOUT_MODE=resolved, to the actual 40-character Docs HEAD.
# DOCS_CHECKOUT_REVISION=
