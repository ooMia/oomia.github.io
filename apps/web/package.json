{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:offline": "node tests/link-card/build.mjs",
    "dev": "astro dev",
    "format": "prettier -w '**/*.astro' --cache --cache-strategy metadata | awk '!/(unchanged)/'",
    "lint": "eslint",
    "preview": "astro preview",
    "spike:markdown": "vp test spikes/markdown-to-js --reporter verbose && node spikes/markdown-to-js/build.mjs && node spikes/markdown-to-js/verify.mjs",
    "sync": "astro sync",
    "test:e2e": "playwright test",
    "test:e2e:compat": "playwright test --grep @compat",
    "test:e2e:evidence": "node tests/homepage-render.mjs",
    "test:link-card": "node tests/link-card/build.mjs --fixture && node tests/link-card/verify.mjs",
    "test:presentation": "pnpm run test:e2e",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@workspace/md": "workspace:*",
    "@workspace/ui": "workspace:*",
    "astro": "catalog:",
    "es-toolkit": "catalog:",
    "fumadocs-core": "^16.15.18",
    "fumadocs-ui": "^16.15.18",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-astro-organize-imports": "^0.4.13",
    "satteri": "0.10.5",
    "typescript": "catalog:",
    "typescript-eslint": "^8.69.0"
  }
}
